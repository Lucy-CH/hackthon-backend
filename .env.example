ENVIRONMENT=development

WEB_APP_NAME="Hackthon Backend Api"
WEB_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Local API connects to the PostgreSQL port published by compose.yaml.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=hackthon
DB_USER=hackthon
DB_PASSWORD=change_me_for_local_development

# Use your own server-side key with Google Routes API enabled.
GOOGLE_ROUTES_API_KEY=replace_with_your_google_routes_api_key

# Optional: server-side DeepSeek AI picks; blank key keeps rental search working.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_CANDIDATES=50
